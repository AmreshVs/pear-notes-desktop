APPLE_BUNDLE_ID=com.amreshvs.pear-notes-mac

MAS_CODESIGN_IDENTITY=3rd Party Mac Developer Application: Your Name (TEAMID)
MAS_INSTALLER_IDENTITY=3rd Party Mac Developer Installer: Your Name (TEAMID)

# Absolute path, kept OUTSIDE the repo so signing material never lives in the tree.
# e.g. ~/.pear-notes-signing/ (no ~ expansion here — write the full path).
MAS_PROVISIONING_PROFILE=/Users/<user>/.pear-notes-signing/Pear_notes_mac.provisionprofile

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
