{
  "name": "pear-notes-desktop",
  "main": "index.js",
  "pear": {
    "name": "pear-notes-desktop",
    "type": "desktop",
    "pre": "pear-electron/pre",
    "gui": {
      "main": "index.html",
      "backgroundColor": "#1F2430",
      "height": "1280",
      "width": "1280",
      "userAgent": "Slackbot-LinkExpanding 1.0 (+https://api.slack.com/robots)"
    },
    "links": {
      "localhost": "http://127.0.0.1",
      "https": "https://*"
    }
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:vite": "vite build --watch --sourcemap inline",
    "dev:pear": "pear run -s ../../storage/notebaseStorage -d .",
    "build": "vite build",
    "lint": "eslint .",
    "prettier-fix": "prettier . --write",
    "test": "brittle test/*.test.js"
  },
  "dependencies": {
    "@pear-notes/core": "file:../pear-notes-core",
    "@reduxjs/toolkit": "^2.10.1",
    "@tiptap/extension-bubble-menu": "^3.15.3",
    "@tiptap/extension-code-block-lowlight": "^3.15.3",
    "@tiptap/extension-highlight": "^3.10.4",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-link": "^3.10.4",
    "@tiptap/extension-placeholder": "^3.10.4",
    "@tiptap/extension-strike": "^3.10.4",
    "@tiptap/extension-subscript": "^3.10.4",
    "@tiptap/extension-superscript": "^3.10.4",
    "@tiptap/extension-table": "^3.15.3",
    "@tiptap/extension-table-cell": "^3.15.3",
    "@tiptap/extension-table-header": "^3.15.3",
    "@tiptap/extension-table-row": "^3.15.3",
    "@tiptap/extension-task-item": "^3.10.4",
    "@tiptap/extension-task-list": "^3.10.4",
    "@tiptap/extension-text-align": "^3.10.4",
    "@tiptap/extension-underline": "^3.10.4",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.10.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.553.0",
    "pear-bridge": "^1.2.4",
    "pear-electron": "^1.7.26",
    "pear-run": "^2.0.0",
    "qrcode.react": "^4.2.0",
    "react-redux": "^9.2.0",
    "react-resizable": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^5.0.1",
    "brittle": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pear-interface": "^1.0.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "prettier-config-standard": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.11",
    "vite": "^7.1.3"
  }
}
