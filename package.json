{
  "name": "pear-notes-desktop",
  "productName": "Pear Notes",
  "version": "1.1.0",
  "buildNumber": 16,
  "description": "Private notes, encrypted on-device and synced peer-to-peer.",
  "author": "AmreshVs",
  "main": "electron/main.cjs",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "setup": "node scripts/setup.cjs",
    "start": "electron-forge start",
    "predev": "vite build",
    "dev": "concurrently \"npm:dev:*\"",
    "dev:vite": "vite build --watch --sourcemap inline --mode development",
    "dev:electron": "node scripts/dev-electron.cjs",
    "build": "vite build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "package:mas": "npm run build && MAS_BUILD=1 electron-forge package --platform=mas",
    "make:mas": "npm run build && MAS_BUILD=1 electron-forge make --platform=mas",
    "release:mac": "node scripts/release-mac.mjs",
    "release:mac:check": "node scripts/release-mac.mjs --check",
    "release:mac:upload": "node scripts/release-mac.mjs --upload",
    "release:mac:dmg": "node scripts/release-mac.mjs --dmg",
    "release:mac:dmg:check": "node scripts/release-mac.mjs --dmg --check",
    "pin-core": "node scripts/pin-core.cjs",
    "harden-core": "node scripts/harden-core.cjs",
    "clean": "rm -rf dist out",
    "lint": "eslint .",
    "prettier-fix": "prettier . --write",
    "test": "brittle test/*.test.js"
  },
  "dependencies": {
    "@pear-notes/core": "github:AmreshVs/pear-notes-core#e9e7526fc1ce8b158ca30b02ae1c8ff43c75ed7b",
    "pear-device-auth": "file:./native/pear-device-auth",
    "pear-runtime": "^1.1.4",
    "which-runtime": "^1.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-msix": "^7.11.2",
    "@electron-forge/maker-pkg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@reduxjs/toolkit": "^2.10.1",
    "@swmansion/argent": "^0.16.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tiptap/extension-bubble-menu": "^3.15.3",
    "@tiptap/extension-code-block-lowlight": "^3.15.3",
    "@tiptap/extension-highlight": "^3.10.4",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-link": "^3.10.4",
    "@tiptap/extension-placeholder": "^3.10.4",
    "@tiptap/extension-strike": "^3.10.4",
    "@tiptap/extension-subscript": "^3.10.4",
    "@tiptap/extension-superscript": "^3.10.4",
    "@tiptap/extension-table": "^3.15.3",
    "@tiptap/extension-table-cell": "^3.15.3",
    "@tiptap/extension-table-header": "^3.15.3",
    "@tiptap/extension-table-row": "^3.15.3",
    "@tiptap/extension-task-item": "^3.10.4",
    "@tiptap/extension-task-list": "^3.10.4",
    "@tiptap/extension-text-align": "^3.10.4",
    "@tiptap/extension-underline": "^3.10.4",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.10.4",
    "@vitejs/plugin-react": "^5.0.1",
    "brittle": "^3.0.0",
    "buffer": "^5.7.1",
    "concurrently": "^10.0.5",
    "corestore": "^7.9.1",
    "electron": "^40.10.5",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "events": "^3.3.0",
    "framed-stream": "^1.0.1",
    "globals": "^16.5.0",
    "hyperswarm": "^4.17.0",
    "i18next": "^26.3.6",
    "javascript-obfuscator": "^5.7.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.553.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "prettier-config-standard": "^7.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.10",
    "react-redux": "^9.2.0",
    "react-resizable": "^3.1.3",
    "streamx": "^2.28.1",
    "tailwindcss": "^4.1.11",
    "terser": "^5.51.2",
    "vite": "^7.1.3"
  }
}
